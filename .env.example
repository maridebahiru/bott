# ==========================================================
# Aelafat Countdown Bot - Environment Variables Configuration
# ==========================================================
# Copy this file to .env and fill in your actual values:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/Mac)
# NEVER commit your actual .env file to Git!

# Telegram Bot Token obtained from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID(s) of the bot owner(s) / superadmins (comma-separated if multiple)
# You can find your user ID using bots like @userinfobot or @raw_data_bot
BOT_OWNER_ID=123456789

# Default Telegram Group or Channel ID where daily countdown messages will be posted
# (Can also be set dynamically via the /setgroup command in Telegram)
# Example: -1001234567890
TELEGRAM_GROUP_ID=

# Target Event Date (Format: YYYY-MM-DD)
EVENT_DATE=2027-01-05

# Time Zone for the event and daily posting schedule
TIMEZONE=Africa/Addis_Ababa

# Daily post time in 24-hour HH:MM format (in Ethiopian Africa/Addis_Ababa time)
POST_TIME=09:00

# Path to the SQLite database file
# For local development: aelafat.db
# For Render deployment with persistent disk: /var/data/aelafat.db
DATABASE_PATH=aelafat.db

# Optional promotional banner image URL or local file path
PROMO_IMAGE_URL=

# Default language preference: "am" (Amharic), "en" (English), or "both" (Bilingual)
DEFAULT_LANGUAGE=both

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
